<Window x:Class="WhalePet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鲸鱼娘小助理"
        Width="320" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="True"
        Loaded="OnLoaded" Closing="OnClosing">

    <Grid>
        <!-- 主舞台:立绘 + 阴影 + 气泡 + 菜单 + 召回按钮 -->
        <Canvas x:Name="Stage" ClipToBounds="False">
            <!-- 环境光晕(增强轮廓立体感) -->
            <Ellipse x:Name="Glow" Width="380" Height="440" Canvas.Left="-30" Canvas.Top="30" Opacity="0.4">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3A6EA5" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 水下光斑(浮动光点,增强"在水中"的立体纵深) -->
            <Ellipse x:Name="Light1" Width="52" Height="52" Fill="#CCE8FF" Opacity="0.12" Canvas.Left="40" Canvas.Top="120">
                <Ellipse.Effect>
                    <BlurEffect Radius="12" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="Light2" Width="36" Height="36" Fill="#B8DDFF" Opacity="0.10" Canvas.Left="230" Canvas.Top="200">
                <Ellipse.Effect>
                    <BlurEffect Radius="10" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="Light3" Width="68" Height="68" Fill="#D6ECFF" Opacity="0.09" Canvas.Left="90" Canvas.Top="330">
                <Ellipse.Effect>
                    <BlurEffect Radius="16" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="Light4" Width="30" Height="30" Fill="#A8D4F8" Opacity="0.12" Canvas.Left="250" Canvas.Top="420">
                <Ellipse.Effect>
                    <BlurEffect Radius="8" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- 深海泡泡 -->
            <TextBlock x:Name="BubbleEl1" Text="🫧" FontSize="16" Opacity="0.4" Canvas.Left="40" Canvas.Top="480" />
            <TextBlock x:Name="BubbleEl2" Text="🫧" FontSize="12" Opacity="0.35" Canvas.Left="130" Canvas.Top="300" />
            <TextBlock x:Name="BubbleEl3" Text="🫧" FontSize="20" Opacity="0.3" Canvas.Left="220" Canvas.Top="420" />

            <!-- 心情表情(头顶浮动) -->
            <TextBlock x:Name="EmojiEl" Text="" FontSize="36" Visibility="Collapsed"
                       Canvas.Left="130" Canvas.Top="50" />

            <Ellipse x:Name="Shadow" Width="170" Height="26" Fill="#66000000"
                     Canvas.Left="75" Canvas.Top="512">
                <Ellipse.Effect>
                    <BlurEffect Radius="8" />
                </Ellipse.Effect>
            </Ellipse>

            <Image x:Name="PetImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   Canvas.Left="25" Canvas.Top="14" Width="270" Height="510" Cursor="Hand">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetScale" />
                        <RotateTransform x:Name="PetRotate" CenterX="135" CenterY="470" />
                        <TranslateTransform x:Name="PetTranslate" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <Border x:Name="Bubble" Background="#FFFFFF" CornerRadius="14,14,4,14"
                    BorderBrush="#3A6EA5" BorderThickness="1" MaxWidth="280" MaxHeight="200"
                    Visibility="Collapsed" Canvas.Left="20" Canvas.Top="4"
                    Opacity="0.97">
                <ScrollViewer MaxHeight="198" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="BubbleText" TextWrapping="Wrap" FontSize="13.5"
                               Foreground="#1C2B45" LineHeight="21" MaxWidth="256"
                               Margin="12,9" />
                </ScrollViewer>
            </Border>

            <Border x:Name="Menu" Background="#132035" CornerRadius="12" Padding="5"
                    BorderBrush="#3A6EA5" BorderThickness="1" Visibility="Collapsed"
                    Canvas.Left="196" Canvas.Top="40" Opacity="0.97">
                <StackPanel x:Name="MenuItems" />
            </Border>

            <!-- 小鱼干(摸头时她有几率叼出来给你) -->
            <TextBlock x:Name="FishEl" Text="🐟" FontSize="34" Visibility="Collapsed" Cursor="Hand"
                       Canvas.Left="150" Canvas.Top="420" ToolTip="小鱼干!点一下吃掉"
                       MouseLeftButtonUp="FishEl_MouseUp" />

            <!-- 称呼设置面板 -->
            <Border x:Name="NamePanel" Background="#132035" CornerRadius="12" Padding="14"
                    BorderBrush="#3A6EA5" BorderThickness="1" Visibility="Collapsed"
                    Canvas.Left="24" Canvas.Top="150" Opacity="0.98">
                <StackPanel>
                    <TextBlock Text="📝 想让鲸鱼娘怎么称呼你?" Foreground="#EAF2FB" FontSize="13.5"
                               Margin="0,0,0,10" />
                    <TextBox x:Name="NameInput" Width="200" Background="#16324F" Foreground="White"
                             CaretBrush="White" BorderBrush="#4A90D9" FontSize="13" Padding="6,5"
                             KeyDown="NameInput_KeyDown" />
                    <Button x:Name="NameOk" Content="确定 💙" Width="70" Background="#3A6EA5"
                            Foreground="White" BorderThickness="0" Margin="0,10,0,0"
                            HorizontalAlignment="Right" Cursor="Hand" Click="NameOk_Click" />
                </StackPanel>
            </Border>

            <Button x:Name="RecallBtn" Width="52" Height="52" Content="🐳"
                    FontSize="24" Visibility="Collapsed" Background="#16324F"
                    BorderBrush="#3A6EA5" BorderThickness="2" Foreground="White"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center" Canvas.Left="248" Canvas.Top="508"
                    Cursor="Hand" ToolTip="把鲸鱼娘叫回来" />
        </Canvas>
    </Grid>
</Window>
